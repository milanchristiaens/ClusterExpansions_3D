#!/bin/bash
# Stage 1: runs ising_model_3D_CE_pepos.jl, which writes the CE PEPOs of all β (and the start states of the vbPEPS) into data/pepos/*.jld2 for all compare jobs.
# It uses 4 cores for the memory.
#PBS -A starting_2026_079
#PBS -N pepos
#PBS -l nodes=1:ppn=4
#PBS -l walltime=02:00:00
#PBS -j oe

source "$VSC_SCRATCH_PROJECTS_BASE/starting_2026_079/ClusterExpansions/development/hpc/hortense_env.sh"
cd "$REPO"
julia -t 4 --project=. development/initial_pepos/ising_model_3D_CE_pepos.jl
