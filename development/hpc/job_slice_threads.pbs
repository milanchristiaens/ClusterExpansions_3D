#!/bin/bash
# Looks at the use of the 4 cores by the sliced contraction: Julia and BLAS threads with a profile, the garbage-collection rules,
# and slices in parallel tasks, for one set of dimensions. Results in data/contraction_plans/slice_threads/<run>/.
#PBS -A starting_2026_079
#PBS -N slice_threads
#PBS -l nodes=1:ppn=4
#PBS -l walltime=03:00:00
#PBS -j oe

# ---------------- settings ----------------
DIMS="12,5,3"          # (χenv,χpeps,D)
MAX_HOURS=2.5          # no new run is started after this many hours
# ------------------------------------------

source "$VSC_SCRATCH_PROJECTS_BASE/starting_2026_079/ClusterExpansions/development/hpc/hortense_env.sh"
export OPENBLAS_NUM_THREADS=4
export CE_ST_DIMS="$DIMS" CE_ST_HOURS=$MAX_HOURS
cd "$REPO"
julia -O1 -t 4 --project=. development/contraction_plans/slice_threads.jl
