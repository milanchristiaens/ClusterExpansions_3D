#!/bin/bash
# One CTMRG3D check (CHECK = west_updates, init or exponent) on 4 Hortense cores, as the CTMRG3D compare.
# Needs the PEPO files (job_pepos.pbs first).
#PBS -A starting_2026_079
#PBS -N check_ctmrg3d
#PBS -l nodes=1:ppn=4
#PBS -l walltime=30:00:00
#PBS -j oe

source "$VSC_SCRATCH_PROJECTS_BASE/starting_2026_079/ClusterExpansions/development/hpc/hortense_env.sh"
export OPENBLAS_NUM_THREADS=4
export CE_CHECK_MACHINE=hortense
export CE_CHECK_PLANS=false
cd "$REPO"
julia -t 4 --project=. development/checks/ctmrg_3d/check_ctmrg3d_${CHECK:-init}.jl
