#!/bin/bash
# Check of the extra AD term of the vbPEPS (differentiate_environment false against true) on 4 Hortense cores.
# Needs the PEPO files (job_pepos.pbs first).
#PBS -A starting_2026_079
#PBS -N check_ad
#PBS -l nodes=1:ppn=4
#PBS -l walltime=16:00:00
#PBS -j oe

source "$VSC_SCRATCH_PROJECTS_BASE/starting_2026_079/ClusterExpansions/development/hpc/hortense_env.sh"
export OPENBLAS_NUM_THREADS=1
cd "$REPO"
julia -t 4 --project=development/fast_vbpeps development/checks/vbpeps/check_vbpeps_diff_env.jl
