#!/bin/bash
# Monte Carlo reference of the 3D Ising model (ising_3d_mc.jl, Wolff clusters) on 1 Hortense core.
# It appends to data/reference/ising3d_mc.csv, which the magnetization plots of the compare scripts read.
#PBS -A starting_2026_079
#PBS -N ising_mc
#PBS -l nodes=1:ppn=1
#PBS -l walltime=04:00:00
#PBS -j oe

source "$VSC_SCRATCH_PROJECTS_BASE/starting_2026_079/ClusterExpansions/development/hpc/hortense_env.sh"
export MC_LS=${MC_LS:-16,32,64}
export MC_BETAS=${MC_BETAS:-0.15,0.19,0.21,0.22,0.225,0.23,0.25,0.35}
export MC_SWEEPS=${MC_SWEEPS:-20000}
export MC_THERM=${MC_THERM:-2000}
export MC_SEED=${MC_SEED:-1}
cd "$REPO"
julia --startup-file=no development/reference/ising_3d_mc.jl
