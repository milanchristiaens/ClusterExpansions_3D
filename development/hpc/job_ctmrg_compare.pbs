#!/bin/bash
# Runs ising_model_3D_CE_CTMRG_compare.jl on CORES Hortense cores: one job of a pilot or of a full run, as submitted by submit_compare.sh.
# Needs the PEPO files (job_pepos.pbs first).
#PBS -A starting_2026_079
#PBS -N ctmrg_compare
#PBS -l nodes=1:ppn=5
#PBS -l walltime=14:30:00
#PBS -j oe

# ---------------- settings ----------------
JULIA_THREADS=${CORES:-5}  # CTMRG3D: Julia threads = BLAS threads = cores; submit_compare.sh passes CORES and ppn together (qsub -l nodes=1:ppn=..)
# ------------------------------------------

source "$VSC_SCRATCH_PROJECTS_BASE/starting_2026_079/ClusterExpansions/development/hpc/hortense_env.sh"
export OPENBLAS_NUM_THREADS=$JULIA_THREADS
export CE_COMPARE_PROFILE=${PROFILE:-pilot}
export CE_COMPARE_CORES=$JULIA_THREADS
[ -n "${DIMS:-}" ] && export CE_COMPARE_DIMS=$DIMS
[ -n "${CASE:-}" ] && export CE_COMPARE_CASES=$CASE
[ -n "${RUN:-}" ] && export CE_COMPARE_RUN=$RUN
# Julia's garbage collector aims at HEAP_FRACTION of the job memory (cores × 1.86 GiB) through --heap-size-hint: Julia sees the whole node
# and would otherwise let garbage grow past the job limit (0.75: the contraction with the 5 GiB plans keeps about 4 GiB alive)
HEAP_FRACTION=${HEAP_FRACTION:-0.75}
HEAP_HINT_MIB=$(awk -v c=$JULIA_THREADS -v f=$HEAP_FRACTION 'BEGIN { printf "%d", c * 1.86 * 1024 * f }')
cd "$REPO"
julia -t $JULIA_THREADS --heap-size-hint=${HEAP_HINT_MIB}M --project=. development/profiling/comparing/ising_model_3D_CE_CTMRG_compare.jl
