#!/bin/bash
# job_benchmark_plans.pbs -- times the 3 GiB contraction plans of the candidates of the CTMRG3D dimension pilot on 4 Hortense cores (about 7.4 GiB),
# the cores and threads with which the CTMRG3D compare runs there (profile hpc of benchmark_contract_onesite.jl, see PROFILES at the top of that file).
# The times go into src/utility/onesite_plans.csv with machine = hortense (copy that file back to the laptop afterwards, see the guide).
# Submit on the login node, in the clone folder:
#   module swap cluster/dodrio/cpu_milan_rhel9
#   qsub development/hpc/job_benchmark_plans.pbs
# Only the time that the job really used is charged.
#PBS -A starting_2026_079
#PBS -N bench_plans
#PBS -l nodes=1:ppn=4
#PBS -l walltime=20:00:00
#PBS -j oe

# ---------------- settings ----------------
JULIA_THREADS=4           # the plans are timed with 4 Julia threads and 4 BLAS threads, as the CTMRG3D compare uses them
BLAS_THREADS=4
# ------------------------------------------

source "$VSC_SCRATCH_PROJECTS_BASE/starting_2026_079/ClusterExpansions/development/hpc/hortense_env.sh"
export CE_BENCH_PROFILE=hpc
export OPENBLAS_NUM_THREADS=$BLAS_THREADS     # the child processes of the benchmark take their BLAS threads from here
cd "$REPO"
julia -O1 -t $JULIA_THREADS --project=. development/contraction_plans/benchmark_contract_onesite.jl
