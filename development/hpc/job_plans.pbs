#!/bin/bash
# job_plans.pbs -- everything that writes the plan file, one after the other in ONE job (round 1 of the Hortense guide), on 4 Hortense cores (as the
# CTMRG3D compare):
# 1) For the selected cases: (8,4,3), (11,5,3), (18,6,3) and current and ome-sc trees: reuse vs. manual and mock vs. real environment (development/contraction_plans/env_loader_pepo.jl)
# a few CTMRG3D iterations of the Ising PEPO of the PEPO file, 
# 2) the full benchmark (profile :hpc: all 3 GiB plans of the CTMRG3D candidates, mock environment, reuse allocator).

# In series, because 1) and 2) write the same plan file. Nothing else writes the plan file in round 1 (the pilots and checks slice the current tree).
# Submitted by submit_round1.sh, or on the login node, in the clone folder:
#   module swap cluster/dodrio/cpu_milan_rhel9
#   qsub development/hpc/job_plans.pbs
#PBS -A starting_2026_079
#PBS -N plans
#PBS -l nodes=1:ppn=4
#PBS -l walltime=60:00:00
#PBS -j oe

# ---------------- settings ----------------
JULIA_THREADS=4           # as the CTMRG3D compare: 4 Julia threads and 4 BLAS threads
BLAS_THREADS=4
# ------------------------------------------

source "$VSC_SCRATCH_PROJECTS_BASE/starting_2026_079/ClusterExpansions/development/hpc/hortense_env.sh"
export OPENBLAS_NUM_THREADS=$BLAS_THREADS     # the child processes of the benchmark take their BLAS threads from here
cd "$REPO"
CE_BENCH_PROFILE=validate CE_BENCH_ENV=mock julia -O1 -t $JULIA_THREADS --project=. development/contraction_plans/benchmark_contract_onesite.jl
CE_BENCH_PROFILE=validate CE_BENCH_ENV=real julia -O1 -t $JULIA_THREADS --project=. development/contraction_plans/benchmark_contract_onesite.jl
CE_BENCH_PROFILE=hpc      CE_BENCH_ENV=mock julia -O1 -t $JULIA_THREADS --project=. development/contraction_plans/benchmark_contract_onesite.jl
