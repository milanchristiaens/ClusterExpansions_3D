#!/bin/bash
# job_plans.pbs -- everything that writes the plan file on Hortense, one after the other in ONE job (the plan file must not be written by two jobs):
# 1) find_orders_ome.jl for the sets that have no plans yet (NEW_DIMS): it appends their plans to src/utility/onesite_plans.csv;
# 2) the benchmark (profile :hpc of benchmark_contract_onesite.jl: the 3 GiB plans of (8,4,3), (10,5,3), (12,4,3), (12,5,3), (16,4,3), (16,5,3),
#    (16,6,3), (18,6,3), mock environment (round 1 showed mock = real to within 3-5 %), reuse allocator). Plans that already have a Hortense time are
#    not timed again.
# Cores: the benchmark runs TWO Julia processes at a time (the parent and the child that contracts one plan); Slurm counts both. On 4 cores the run of
# 20 Nov was killed at 7.4 GiB, so we take 8 cores (about 14.9 GiB) for the memory, but time with THREADS Julia and BLAS threads (the number of cores
# of the CTMRG3D jobs), so that the times hold for those jobs.
# Estimate (not measured): 1) under 1 h, 2) 6-15 h (mostly (16,6,3) and (18,6,3); the benchmark stops starting plans after max_hours = 16).
# Submit on the login node, in the clone folder:
#   module swap cluster/dodrio/cpu_milan_rhel9
#   qsub development/hpc/job_plans.pbs
#PBS -A starting_2026_079
#PBS -N plans
#PBS -l nodes=1:ppn=8
#PBS -l walltime=18:00:00
#PBS -j oe

# ---------------- settings ----------------
THREADS=${THREADS:-5}                          # Julia and BLAS threads of the benchmark = the cores of the CTMRG3D jobs (CTMRG_CORES in submit_compare.sh)
NEW_DIMS=${NEW_DIMS:-10_5_3,12_4_3,12_5_3,16_4_3}   # sets without plans in the plan file (empty: skip step 1)
# ------------------------------------------

source "$VSC_SCRATCH_PROJECTS_BASE/starting_2026_079/ClusterExpansions/development/hpc/hortense_env.sh"
export OPENBLAS_NUM_THREADS=$THREADS     # the child processes of the benchmark take their BLAS threads from here
cd "$REPO"
if [ -n "$NEW_DIMS" ]; then
    CE_ORDERS_DIMS=$NEW_DIMS julia -t $THREADS --project=. development/contraction_plans/find_orders_ome.jl
fi
CE_BENCH_PROFILE=hpc CE_BENCH_ENV=mock julia -O1 -t $THREADS --project=. development/contraction_plans/benchmark_contract_onesite.jl
