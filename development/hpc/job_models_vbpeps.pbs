#!/bin/bash
# Runs models_3D_CE_vbpeps_compare.jl for one model on CORES cores with BetterPEPSKit (environment development/fast_vbpeps).
# Needs the model PEPO files with the vbPEPS tensors (job_models_pepos.pbs first).
#PBS -A starting_2026_079
#PBS -N models_vbpeps
#PBS -l nodes=1:ppn=4
#PBS -l walltime=26:00:00
#PBS -j oe

source "$VSC_SCRATCH_PROJECTS_BASE/starting_2026_079/ClusterExpansions/development/hpc/hortense_env.sh"
JULIA_THREADS=${CORES:-4}     # one Julia thread per core, 1 BLAS thread each
export OPENBLAS_NUM_THREADS=1
export CE_COMPARE_CORES=$JULIA_THREADS
export CE_COMPARE_IMPL=betterpepskit
[ -n "${MODEL:-}" ] && export CE_MODEL=$MODEL
[ -n "${DIMS:-}" ] && export CE_COMPARE_DIMS=$DIMS
[ -n "${CASE:-}" ] && export CE_COMPARE_CASES=$CASE
[ -n "${RUN:-}" ] && export CE_COMPARE_RUN=$RUN
[ -n "${BETAS:-}" ] && export CE_COMPARE_BETAS=$BETAS
[ -n "${BUDGET_S:-}" ] && export CE_COMPARE_BUDGET_S=$BUDGET_S
HEAP_HINT_MIB=$(awk -v c=$JULIA_THREADS 'BEGIN { printf "%d", c * 1.86 * 1024 * 0.6 }')
cd "$REPO"
julia -t $JULIA_THREADS --heap-size-hint=${HEAP_HINT_MIB}M --project=development/fast_vbpeps development/profiling/comparing/models_3D_CE_vbpeps_compare.jl
